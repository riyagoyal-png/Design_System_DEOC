{
  "name": "design-system-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone interactive showcase of the Dark Operations Console design system (spec/DESIGN_SYSTEM.md).",
  "scripts": {
    "spec": "node scripts/extract-spec.mjs",
    "dev": "npm run spec && vite",
    "build": "npm run spec && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "qa": "npm run build && npm run check:tokens && npm run check:browser && npm run check:interactions",
    "check:interactions": "node scripts/check-interactions.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "playwright-core": "1.49",
    "postcss": "^8.5.29",
    "typescript": "5.7",
    "vite": "^6.4.4"
  }
}
